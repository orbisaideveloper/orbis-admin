{
  "name": "orbis-admin",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint apps packages vitest.config.ts vitest.setup.ts --max-warnings=0",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "check:deadcode:ci": "knip --config knip.json",
    "check:duplicates:ci": "jscpd apps packages --config .jscpd.json",
    "build": "npm run build --workspace @orbis-admin/contracts && npm run build --workspace @orbis-admin/api && npm run build --workspace @orbis-admin/web",
    "test:smoke": "vitest run apps/api/src/index.test.ts",
    "dev:web": "npm run dev --workspace @orbis-admin/web",
    "dev:api": "npm run dev --workspace @orbis-admin/api",
    "check:workflows": "node scripts/validate-workflows.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jscpd": "^5.2.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
