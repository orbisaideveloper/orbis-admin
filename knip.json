{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".orbis-backup/**"
  ],
  "ignoreDependencies": [
    "jsdom"
  ],
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/contracts": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
