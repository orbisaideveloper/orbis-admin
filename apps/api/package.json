{
  "name": "@orbis-admin/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx -e \"import('./src/index.ts').then(({ startServer }) => startServer(Number(process.env.PORT || 3001)))\"",
    "build": "tsc -p tsconfig.json",
